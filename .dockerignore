# Keep the build context small: the Dockerfile only copies what it needs.
.git
.gitignore
.gitattributes
**/__pycache__
*.py[cod]
venv/
.venv/
env/
.vscode/
.idea/
.gemini/
.claude/

# Secrets & local DB
.env
.env.*
db.sqlite3*

# Not part of the backend image
frontend/
mobile/
node_modules/
scripts/
!scripts/trim_vocab.py
data/raw/
# downloaded (and checksum-verified) during the build
models/
*.zip
*_indexed.json
*.index
README.md
docs/
*.log
*.tmp
*.bak
